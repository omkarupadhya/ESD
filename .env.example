# Environment variables template for ESD Lab 2
# Copy this file to .env:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)

# Base64-encoded secret, minimum 32 bytes (256 bits)
# Generated via: openssl rand -base64 32
JWT_SECRET=c2VjcmV0LWtleS1mb3ItZXNkLWxhYi0yLXNlY3VyZS1rZXk=

# Password for admin@esd.local seeded account
ADMIN_PASSWORD=Admin1234!

# PostgreSQL database credentials
DB_USER=postgres
DB_PASS=postgres
